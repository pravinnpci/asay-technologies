# ==========================================
# ASAY InfoTech - Environment Configuration
# ==========================================

# Official Company Email for Inquiries & Job Applications
VITE_COMPANY_EMAIL="asayinfotech@gmail.com"

# Primary WhatsApp / Phone Number (Format: +91XXXXXXXXXX)
VITE_WEBSITE_WHATSAPP_NUMBER="+916382907182"

# EmailJS Configuration (Free Tier: 200 emails/mo - for instant direct ACK emails to users)
VITE_EMAILJS_SERVICE_ID="YOUR_EMAILJS_SERVICE_ID_HERE"
VITE_EMAILJS_TEMPLATE_ID="YOUR_EMAILJS_TEMPLATE_ID_HERE"
VITE_EMAILJS_PUBLIC_KEY="YOUR_EMAILJS_PUBLIC_KEY_HERE"

# Google Gemini AI API Key (Optional - Fallback hybrid engine active by default)
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Twilio Configuration (Optional - for SMS / WhatsApp Business alerts)
VITE_TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID_HERE"
VITE_TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN_HERE"
VITE_TWILIO_CONTENT_SID="YOUR_TWILIO_CONTENT_SID_HERE"

# Google Services (Analytics & AdSense)
VITE_GOOGLE_ANALYTICS_ID=
VITE_GOOGLE_ADSENSE_ID=

# Zoho ZeptoMail Configuration (help@asayinfotech.in)
VITE_ZEPTOMAIL_TOKEN=
VITE_ZEPTOMAIL_FROM_EMAIL=
VITE_ZEPTOMAIL_FROM_NAME=
VITE_ZEPTOMAIL_SMTP_HOST=
VITE_ZEPTOMAIL_SMTP_PORT=

# Development Flags
DISABLE_HMR=false